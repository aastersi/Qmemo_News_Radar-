# QMemo News Radar. Скопируйте в .env и заполните. .env никогда не коммитится.
# Пустое значение = «не задано». Пути ниже для локального запуска; compose.yaml переопределяет их для Docker.

# ---------- Обязательные для `qmemo-radar run` ----------

# Токен отдельного бота этого проекта от @BotFather. Бота Brain не использовать.
RADAR_TELEGRAM_BOT_TOKEN=
# Ваш числовой Telegram ID (например, из @userinfobot). Остальным бот не отвечает.
RADAR_ALLOWED_TELEGRAM_ID=

# ---------- Внешние расходы ----------
# Цель — $0 в месяц. Предел нельзя поднять выше 10: платный вызов сверх него блокируется до запроса.
RADAR_COST_TARGET_USD_MONTHLY=0
RADAR_COST_HARD_LIMIT_USD_MONTHLY=10
# Все платные функции выключены. Выключенная функция не требует ключей ниже.
RADAR_PAID_SOURCES_ENABLED=false
RADAR_PAID_LLM_ENABLED=false
# X recent search: только вместе с RADAR_PAID_SOURCES_ENABLED=true.
RADAR_X_PAID_SEARCH_ENABLED=false

# ---------- Бесплатные источники (без ключей и без BudgetGuard) ----------
# GDELT Global Quotation Graph: цитаты из мировых новостей. Большой поток: десятки тысяч цитат в час.
RADAR_GDELT_ENABLED=false
# Минуты новее «сейчас минус задержка» не запрашиваются: файл за них может ещё появиться.
RADAR_GDELT_SAFETY_LAG_MINUTES=10
# Сколько минутных файлов проверить за один сбор; ограничивает догон после простоя.
RADAR_GDELT_MAX_MINUTES_PER_RUN=60
# Языки GDELT через запятую, без учёта регистра (English,Spanish); * — все языки.
RADAR_GDELT_LANGUAGES=English
# Принимать статьи без указанного языка.
RADAR_GDELT_ALLOW_UNKNOWN_LANGUAGE=false
# Минута, которая не читается (403, 5xx, сеть) столько сборов подряд, откладывается в список
# заблокированных, сбор идёт дальше; она повторяется раз в сбор (qmemo-radar gaps).
RADAR_GDELT_BLOCK_AFTER_FAILURES=3
# RSS/Atom-ленты задаются в sources.yaml. Предел размера одного ответа ленты (не больше 5 МБ).
RADAR_RSS_MAX_RESPONSE_BYTES=5000000

# ---------- Нужны только при включённых платных функциях ----------

# App-only Bearer Token из https://console.x.com. Используется только для чтения.
RADAR_X_BEARER_TOKEN=
# Любой OpenAI-совместимый endpoint с POST {base_url}/chat/completions.
# Например: https://api.openai.com/v1  или  https://api.anthropic.com/v1/
RADAR_LLM_BASE_URL=
RADAR_LLM_API_KEY=
# Название модели у этого провайдера, например claude-sonnet-5.
RADAR_LLM_MODEL=
# Верхняя оценка стоимости одного LLM-запроса в долларах. Без неё любой платный LLM-вызов блокируется.
RADAR_LLM_COST_PER_CALL_USD=

# ---------- Необязательные ----------

RADAR_ENVIRONMENT=production
RADAR_LOG_LEVEL=INFO
RADAR_TIMEZONE=Asia/Ho_Chi_Minh
RADAR_DB_PATH=data/radar.db
RADAR_SOURCES_PATH=sources.yaml
# 0 — самый предсказуемый вариант; повышайте, только если провайдер не принимает 0.
RADAR_LLM_TEMPERATURE=0

RADAR_COLLECT_INTERVAL_MINUTES=30
RADAR_MAX_EVENT_AGE_MINUTES=60
# Два или три времени подборок по часовому поясу RADAR_TIMEZONE.
RADAR_DIGEST_TIMES=10:00,15:00,20:00
RADAR_DIGEST_CARD_LIMIT=5
RADAR_DAILY_CARD_LIMIT=10
RADAR_URGENT_THRESHOLD=80
RADAR_DIGEST_THRESHOLD=65
# Должен быть <= RADAR_DIGEST_THRESHOLD; всё ниже порога подборки уходит в архив.
RADAR_ARCHIVE_THRESHOLD=50
RADAR_EVENT_TTL_HOURS=48
# Retention. Удаление только командой `qmemo-radar prune --apply`; то, что видел или трогал
# человек (Telegram, черновик, отзыв, outbox), не удаляется никогда.
# Шум (отфильтрованное, истёкшее, архив без действий человека) и примеры отказов:
RADAR_RAW_RETENTION_DAYS=14
# Варианты текста одной истории и упоминания точных копий (происхождение):
RADAR_RETENTION_EVIDENCE_DAYS=7

# ---------- Публикация: должна оставаться false ----------
# Реальных публикаторов Quote Memorial и X нет. Значение true останавливает `run` с ошибкой конфигурации.
RADAR_QMEMO_PUBLISHING_ENABLED=false
RADAR_X_PUBLISHING_ENABLED=false
